# Cổng chạy server
PORT=3000

# Domain hiển thị cho link rút gọn (không có dấu / cuối)
BASE_URL=http://localhost:3000

# Kết nối PostgreSQL - dùng 1 trong 2 cách bên dưới

# Cách 1: dùng connection string (khuyên dùng, ví dụ khi deploy lên Render/Railway/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/url_shortener

# Cách 2: khai báo riêng lẻ (nếu không set DATABASE_URL, server sẽ dùng các biến dưới đây)
PGHOST=localhost
PGPORT=5432
PGDATABASE=url_shortener
PGUSER=postgres
PGPASSWORD=postgres

# Độ dài mã rút gọn mặc định (số ký tự)
CODE_LENGTH=6
